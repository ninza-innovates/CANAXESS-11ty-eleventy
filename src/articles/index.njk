---
pagination:
 data: collections.posts
 size: 10
 alias: articlesPosts
 reverse: true
---
{% for post in articlesPosts %}
    <h2 class="articleList-articleTitle"><a href="{{ post.url }}">{{ post.data.title }}</a></h2> 
	<p>{{ post.data.subtitle }}</p>
	<p class="articleList-date">
	Published <time date-time="{{ post.date.toISOString() }}">{{ post.data.dateFormat }}</time>
	</p>
{% endfor %}

<nav aria-labelledby="pagination" class="pagination">
  <ol class="pagination__list">
    <li class="pagination__item pagination__item--prev">{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" class="pagination__link" aria-label="Previous article list">Previous</a>{% endif %}</li>
    <li class="pagination__item pagination__item--next">{% if pagination.href.next %}<a href="{{ pagination.href.next }}" class="pagination__link" aria-label="Next article list">Next</a>{% endif %}</li>
  </ol>
</nav>
